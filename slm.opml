                <outline text="Ethics" />
                <outline text="Responsibility" />
                <outline text="Kindness" />
              </outline>
              <outline text="Discipline and guidance">
                <outline text="Setting boundaries" />
                <outline text="Positive reinforcement" />
                <outline text="Age-appropriate consequences" />
              </outline>
            </outline>
            <outline text="Providing Emotional Support">
              <outline text="Unconditional love and acceptance ">
                <outline text="Feeling secure regardless of mistakes" />
              </outline>
              <outline text="Validation of feelings">
                <outline text="Listening" />

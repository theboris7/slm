        <outline text="Life Knowledge">
          <outline text="The Universal Principles of Success">
            <outline text="Mindset">
              <outline text="Growth mindset" />
              <outline text="Resilience" />
              <outline text="Adaptability" />
              <outline text="Continuous Learning &amp; Self-Improvement" />
            </outline>
            <outline text="Focus">
              <outline text="Clarity of goals" />
              <outline text="Effective prioritization" />
              <outline text="Elimination of distractions" />
            </outline>
            <outline text="Consistency">
              <outline text="Sustained effort" />
              <outline text="Discipline" />
            </outline>
            <outline text="Action">
              <outline text="Decisive" />
              <outline text="Persistent" />
            </outline>
          </outline>
          <outline text="The Universal Principles of Life">
            <outline text="Energy follows attention" />
            <outline text="Our main resource is focused attention" />
          </outline>
          <outline text="The Universal How-To">
            <outline text="Regularity: Emphasize the frequency of actions (daily, weekly, etc.) over intensity or duration." />
            <outline text="Incremental Increases: Focus on small, achievable improvements over time versus aiming for massive leaps." />
            <outline text="Compounding Effect: 1% more daily = 38 times in a year" />
          </outline>
          <outline text="The Universal Structures and Frameworks">
            <outline text="Thought -&amp;gt; Action -&amp;gt; Habit -&amp;gt; Character -&amp;gt; Destiny" />
            <outline text="Essence -&amp;gt; Form -&amp;gt; Structure" />
            <outline text="Plan -&amp;gt; Action -&amp;gt; Revision -&amp;gt; Adaptation" />
            <outline text="Problem -&amp;gt; Hypothesis -&amp;gt; Experiment -&amp;gt; Analysis -&amp;gt; Solution" />
            <outline text="Chaos -&amp;gt; Emergence -&amp;gt; Order" />
            <outline text="Input -&amp;gt; Process -&amp;gt; Output" />
            <outline text="Behavioral psychology frameworks">
              <outline text="Need/Desire -&amp;gt; Motivation -&amp;gt; Goal -&amp;gt; Action -&amp;gt; Outcome" />
              <outline text="Stimulus -&amp;gt; Response -&amp;gt; Consequence " />
            </outline>
            <outline text="Story Structures">
              <outline text="Hero's Journey" />
              <outline text="Three-Act Structure" />
              <outline text="Conflict -&amp;gt; Climax -&amp;gt; Resolution" />
            </outline>
            <outline text="Birth -&amp;gt; Growth -&amp;gt; Maturity -&amp;gt; Decline -&amp;gt; Renewal" />
            <outline text="Dialectical thinking">
              <outline text="Thesis -&amp;gt; Antithesis -&amp;gt; Synthesis" />
            </outline>
            <outline text="Perception -&amp;gt; Interpretation -&amp;gt; Action" />
            <outline text="Domain-Specific Structures">
              <outline text="Design Thinking">
                <outline text="Empathize -&amp;gt; Define -&amp;gt; Ideate -&amp;gt; Prototype -&amp;gt; Test" />
              </outline>
            </outline>
            <outline text="Learning Cycles: ">
              <outline text="Kolb's model">
                <outline text="Experience -&amp;gt; Reflect -&amp;gt; Conceptualize -&amp;gt; Experiment" />
              </outline>
            </outline>
          </outline>
          <outline text="Models">
            <outline text="Decision-Making Models">
              <outline text="Rational Model:">
                <outline text="Assumptions: Humans want to maximize benefits, and have the information for fully logical choices." />
                <outline text="Steps: ">
                  <outline text="1. Define the problem " />
                  <outline text="2. Identify ALL options " />
                  <outline text="3. Evaluate pros/cons based on criteria " />
                  <outline text="4. Choose the optimal solution " />
                  <outline text="5. Implement" />
                </outline>
                <outline text="Best For: Decisions with clear objectives, measurable data, and low emotional stakes." />
              </outline>
              <outline text="Intuitive Model:">
                <outline text="Assumptions: Relies on gut feelings, experience, and pattern recognition" />
                <outline text="Strengths: Can be fast, especially when data is incomplete or there are time pressures." />
                <outline text="Weaknesses: Prone to biases, difficult to articulate the reasoning behind the decision." />
                <outline text="Best For: When expertise is high, or as a complement to more analytical models." />
              </outline>
              <outline text="Satisficing Model:">
                <outline text="Assumptions: We aim for &quot;good enough&quot; rather than perfect due to cognitive limitations." />
                <outline text="Process: Set minimum criteria, choose the first option that meets them." />
                <outline text="Best For: When speed matters more than the absolute best solution, or there are too many options." />
              </outline>
              <outline text="Recognition-Primed Decision Model">
                <outline text="Assumption: Draws heavily on experience and pattern recognition for quick, real-world decision-making." />
                <outline text="Process: Identify cues in the situation, match them to past experiences, choose a course of action that worked previously." />
                <outline text="Best For: Experienced professionals in their field (firefighters, paramedics), dynamic situations." />
              </outline>
              <outline text="Decision Trees">
                <outline text="Visual tool for analyzing sequential decisions and potential outcomes, often incorporating probabilities. Best for when you can map out possible pathways." />
              </outline>
              <outline text="Pro/Con Grid with Weighting">
                <outline text="Forces you to consider multiple factors beyond simple good/bad lists. Weighting factors by importance adds nuance." />
              </outline>
              <outline text="OODA Loop (Observe, Orient, Decide, Act)">
                <outline text="Originally for military strategy, but useful for rapid decision-making in fast-changing environments. Emphasizes acting and then course-correcting." />
              </outline>
            </outline>
            <outline text="Change Management Models">
              <outline text="ADKAR Model (Prosci)">
                <outline text="Focus: Individual change within an organization, helping employees navigate transitions" />
                <outline text="Stages:">
                  <outline text="Awareness (of the need for change)" />
                  <outline text="Desire (to participate in the change)" />
                  <outline text="Knowledge (of how to change)" />
                  <outline text="Ability (to implement new skills)" />
                  <outline text="Reinforcement (to sustain the change)" />
                </outline>
                <outline text="Best For: Change initiatives requiring buy-in and behavior shifts from a large group of people" />
              </outline>
              <outline text="Kotter's 8-Step Process">
                <outline text="Focus: Broader organizational transformation" />
                <outline text="Stages:">
                  <outline text="Create Urgency" />
                  <outline text="Build Guiding Coalition" />
                  <outline text="Form Strategic Vision" />
                  <outline text="Enlist a Volunteer Army (communicate, get buy-in)" />
                  <outline text="Enable Action (remove barriers)" />
                  <outline text="Generate Short-Term Wins" />
                  <outline text="Don't Let Up (build on momentum)" />
                  <outline text="Make it Stick (embed changes into culture)" />
                </outline>
                <outline text="Best For: Large-scale change, addressing organizational inertia and overcoming resistance." />
              </outline>
              <outline text="Lewin's Change Model (Unfreeze, Change, Refreeze): ">
                <outline text="Classic model emphasizing the need to destabilize the status quo before lasting change can occur." />
              </outline>
              <outline text="Bridges Transitions Model: ">
                <outline text="Focuses on the internal psychological process individuals go through during change (Ending, Neutral Zone, New Beginning). Useful for empathy." />
              </outline>
              <outline text="Nudge Theory: Making subtle changes to the choice environment to influence behavior (placing healthy food at eye level). Can be ethical or manipulative – use wisely!" />
            </outline>
            <outline text="Problem-Solving">
              <outline text="Root-Cause Analysis">
                <outline text="5 Whys: Start with a problem statement. Ask &quot;Why?&quot; did this happen? Dig at least 5 layers deep, going beyond the obvious." />
                <outline text="Fishbone Diagram (Ishikawa Diagram):">
                  <outline text="Technique: Visually maps potential causes by category (Common ones: People, Methods, Machines, Materials, Measurement, Environment)." />
                  <outline text="Example: Fish head = problem, bones = categories, sub-bones = specific causes under each category." />
                </outline>
                <outline text="Pareto Chart: Helps focus on the causes with the BIGGEST impact (80/20 rule)." />
                <outline text="Fault Tree Analysis: More rigorous for high-risk scenarios (aviation, etc.)." />
                <outline text="Kepner-Tregoe: Structured method with built-in analysis questions." />
              </outline>
              <outline text="Design Thinking (Empathize, Define, Ideate, etc.): A flexible framework for solving complex problems in a human-centered way, emphasizes experimentation, not just linear solutions." />
              <outline text="Cynefin Framework: Helps categorize problems based on complexity (Simple, Complicated, Complex, Chaotic) so you use the right tools for the situation." />
            </outline>
            <outline text="Self-Awareness &amp; Growth">
              <outline text="Johari Window: A model for understanding what is known to you, known to others, unknown to both, etc. Encourages feedback and expands self-knowledge." />
              <outline text="Wheel of Life: Assess your satisfaction in various life areas (career, relationships, etc.). Highlights imbalances and helps set holistic goals." />
              <outline text="Immunity to Change: A framework for uncovering hidden internal commitments that sabotage even your desired changes (a powerful but deep process)." />
            </outline>
            <outline text="NLP Meta-Model">
              <outline text="Surface vs. Deep Structure: Our language often leaves out, distorts, or generalizes information from our underlying experience of the world." />
              <outline text="Precision through Questions: The Meta-Model provides specific question patterns to recover that missing information and challenge those distortions." />
              <outline text="3 Main Violations: The focus is on these common language patterns that limit understanding:">
                <outline text="Deletions: Missing information (&quot;This always happens&quot;, &quot;I'm bad at this&quot;)." />
                <outline text="Distortions: Inaccurate representations of reality (&quot;Everyone hates me&quot;, &quot;I'll never succeed&quot;)." />
                <outline text="Generalizations: Overly broad statements, usually based on a few experiences (&quot;Men can't be trusted&quot;)." />
              </outline>
            </outline>
          </outline>
        </outline>
      </outline>
      <outline text="&lt;b&gt;Appendix 1: Lists&lt;/b&gt;">
        <outline text="Skills levels">
          <outline text="The Dreyfus Model of Skill Acquisition">
            <outline text="1. Novice: A beginner who follows rules rigidly and lacks contextual understanding of situations." />
            <outline text="2. Advanced Beginner: Someone with limited experience who can recognize situational aspects, but still relies heavily on instructions." />
            <outline text="3. Competent: A person demonstrating conscious planning and decision-making. They have proficiency but still require deliberate effort." />
            <outline text="4. Proficient: An individual now perceiving situations holistically, relying more on intuition than specific rules. They troubleshoot and make adjustments effectively." />
            <outline text="5. Expert: Performance is fluid and intuitive. Experts rely on deep knowledge, have a strong grasp of nuance, and can innovate within their field." />
          </outline>
          <outline text="Consciousness-Competence Ladder">
            <outline text="Unconscious Incompetence: Unaware of a skill's existence or its value." />
            <outline text="Conscious Incompetence: Awareness of the skill and its lack of it in oneself." />
            <outline text="Conscious Competence: Able to perform the skill through deliberate practice." />
            <outline text="Unconscious Competence: The skill becomes natural; minimal conscious thought required." />
          </outline>
        </outline>
        <outline text="External meta-categories:">
          <outline text="money" />
          <outline text="freedom" />
          <outline text="relationships" />
          <outline text="status" />
        </outline>
        <outline text="Internal meta-categories:">
          <outline text="body" />
          <outline text="spirit" />
          <outline text="mind" />
          <outline text="emotions" />
        </outline>
        <outline text="Emotions">
          <outline text="Bronshteyn's Emotions Matrix: &lt;a href=&quot;https://docs.google.com/spreadsheets/d/15EjMNPqlpvHI6uXv-wXFxECQ3bMkvQvIz46r8lD2q8c/edit#gid=0&quot;&gt;https://docs.google.com/spreadsheets/d/15EjMNPqlpvHI6uXv-wXFxECQ3bMkvQvIz46r8lD2q8c/edit#gid=0&lt;/a&gt;" />
          <outline text="Bronshteyn's Emotional Scale full version">
            <outline text="Fear">
              <outline text="Discomfort: A very mild sense of being physically or emotionally ill-at-ease. It's more a vague feeling than a specific emotion, often connected to physical sensations like an upset stomach, slight headache, etc." />
              <outline text="Restlessness: A feeling of being unsettled, an inability to relax, or a low-level agitation.  It doesn't necessarily have a focus, unlike the anticipatory quality of unease." />
              <outline text="Mild Frustration:  A sense of irritation when things don't go smoothly, often due to small setbacks or inconveniences. It's a fleeting displeasure rather than a strong feeling of threat or apprehension." />
              <outline text="Discontentment: A vague sense of dissatisfaction or wanting something to be different. It's more passive than unease and lacks a specific focus of worry." />
              <outline text="Unease: A vague sense of discomfort, feeling unsettled or slightly off-kilter." />
              <outline text="Concern: Focused unease directed at a specific issue or potential problem." />
              <outline text="Worry: Persistent unease and rumination on potential negative outcomes, often about the future." />
              <outline text="Apprehension: A growing sense of nervousness or dread about a perceived threat or impending danger." />
              <outline text="Nervousness:  Anticipatory arousal, often physical (butterflies, jitters), caused by an approaching event or situation." />
              <outline text="Anxiety:  A broader, more pervasive state of worry &amp; apprehension. Can have strong physical symptoms (racing heart, sweating, shortness of breath)." />
              <outline text="Alarm: Heightened fear triggered by the sense of immediate danger, readying the body for a response." />
              <outline text="Fear: The core emotion. An intense response to a recognized (real or perceived) threat, activating the fight-or-flight instinct." />
              <outline text="Dread:  Deep, persistent fear of something terrible happening, often associated with a sense of powerlessness to stop it." />
              <outline text="Fright: Sudden, intense fear with a strong 'startle' component." />
              <outline text="Terror: Overwhelming, paralyzing fear, often felt in the face of extreme danger or violence." />
              <outline text="Horror:  Extreme fear mixed with profound disgust or revulsion. Typically triggered by gruesome, shocking, or violating events." />
              <outline text="Existential Terror: This goes beyond just fearing something specific or even one's own death. It's a profound fear about the meaninglessness of existence, the vastness of the universe, or feeling insignificance in the face of forces beyond comprehension. It can be very unsettling and cause feelings of deep despair." />
              <outline text="Severe Dissociation: In moments of extreme trauma or overwhelming fear, an individual may dissociate as a protective mechanism. This involves feeling disconnected from their body, emotions, and sense of self. While meant to shield the mind from unbearable pain, it is a highly dysregulated state and can be deeply destabilizing." />
              <outline text="Psychosis: During severe psychotic episodes, an individual's grasp on reality can become so fractured that they experience terrifying delusions and hallucinations. While not the same as traditional fear, this state can be incredibly distressing and disorienting." />
              <outline text="Unfathomable Suffering: Witnessing or imagining extreme acts of cruelty, torture, or genocide can evoke an emotional response that surpasses horror.  It involves a mix of revulsion, deep empathy for the victims, and a sense of the capacity for boundless human evil, that can shatter one's faith in humanity." />
            </outline>
            <outline text="Anger">
              <outline text="Irritation: A very mild, fleeting sense of being bothered or disturbed by something minor." />
              <outline text="Displeasure: A slightly stronger feeling of disapproval or dissatisfaction." />
              <outline text="Annoyance:  A mild to moderate feeling of irritation, displeasure, or frustration, often triggered by minor inconveniences, unwanted disturbances, or someone else's behavior. It usually involves a desire for the irritant to stop." />
              <outline text="Frustration: Anger at a situation or obstacle, often when things aren't going as planned." />
              <outline text="Exasperation: A feeling of being at the end of your patience, often accompanied by sighs, eye-rolling, etc." />
              <outline text="Agitation: A heightened sense of frustration, restlessness, and an inability to settle." />
              <outline text="Anger:  A strong emotional response to a perceived provocation, threat, hurt, or injustice. Physiological changes occur (increased heart rate, muscle tension) and it encompasses various degrees of intensity. Anger drives a desire to fight back, confront, or somehow correct the situation." />
              <outline text="Indignation: Righteous anger towards an injustice or something considered deeply wrong or unfair." />
              <outline text="Wrath: More intense than regular anger, often bordering on a desire for retribution or vengeance." />
              <outline text="Fury: Explosive, uncontrolled anger, possibly involving outbursts or violence." />
              <outline text="Rage:  An extreme and often uncontrollable form of anger. It involves a loss of rational control, overwhelming intensity, and can manifest in aggressive outbursts, both verbal and potentially physical. Rage is often accompanied by a sense of being consumed by the emotion." />
              <outline text="Seething: An anger that lingers, simmers beneath the surface, and can flare up again easily." />
              <outline text="Resentment: Deep-seated anger and bitterness about past wrongs, often harbored over time." />
              <outline text="Hatred: The most extreme form, involving deep aversion and possibly a desire to harm." />
            </outline>
            <outline text="Disgust">
              <outline text="Indifference: A lack of feeling towards something, neither positive nor negative. It's a bland emotional state without interest or aversion." />
              <outline text="Apathy: A general lack of motivation, enthusiasm, or emotional engagement. It's a feeling of flatness rather than active dislike." />
              <outline text="Mild Annoyance:  A slight irritation or displeasure, usually caused by a minor inconvenience or frustrating encounter." />
              <outline text="Distraction:  When one's attention is simply focused elsewhere, there might be a vague awareness of something mildly irritating, but not enough to evoke a strong emotional response." />
              <outline text="Boredom:  A state of disinterest, lack of stimulation, and a desire for something engaging" />
              <outline text="Distaste: A mild dislike or unpleasantness associated with a particular thing (a flavor, texture, sound)." />
              <outline text="Aversion: A stronger feeling of dislike, prompting avoidance of the offending stimulus." />
              <outline text="Disgust: The core emotion. A visceral feeling of revulsion and nausea, often triggered by things considered physically or morally contaminated." />
              <outline text="Repugnance:  Intense disgust, bordering on feelings of offense or outrage, especially if the stimulus violates strongly held values." />
              <outline text="Revulsion:  Extreme disgust with a strong physical reaction, possibly including  retching or vomiting." />
              <outline text="Abhorrence: Disgust mixed with deep moral disapproval, often directed towards actions or ideas perceived as deeply wrong or vile." />
              <outline text="Loathing: The most intense level of disgust, often accompanied by hatred or contempt." />
              <outline text="Pure Hatred:  While loathing can be entwined with hatred, pure hatred is arguably more potent.  It involves a desire to actively harm or destroy the object of hatred, often fueled by deep anger or a thirst for revenge." />
              <outline text="Contempt:  More than just loathing, contempt involves completely devaluing the target. It's a sense of utter disregard, believing they are beneath consideration or undeserving of respect." />
              <outline text="Visceral Reactions to Extreme Violence: Witnessing or imagining exceptionally brutal acts can evoke an emotional response beyond &quot;disgust.&quot; It can involve a mix of overwhelming terror, rage, and an utter shattering of one's sense of safety or faith in humanity." />
              <outline text="Self-loathing: In its most extreme form, self-loathing can be profoundly destructive.  It involves intense disgust and hatred directed inwards, leading to self-harming behaviors, despair, and deep feelings of unworthiness." />
              <outline text="Nihilistic Despair:  If loathing is focused on a specific object or concept, nihilistic despair is a broader existential crisis. It's the belief that life is fundamentally meaningless, corrupt, and devoid of goodness, leading to extreme apathy and a lack of hope." />
            </outline>
            <outline text="Sadness">
              <outline text="Melancholy: A gentle wistfulness, a slight tinge of sadness that can even be bittersweet or nostalgic. It's less introspective than pensiveness, focusing on a fleeting moment or recalling memories." />
              <outline text="Discontentment:  A vague dissatisfaction with how things are, a feeling that something is slightly off or lacking. It doesn't have the depth of sadness but can linger in the background." />
              <outline text="Regret: Mild regret focuses on smaller choices or wishing things had turned out slightly differently. It's a &quot;what if&quot; feeling rather than the deeper sadness associated with significant loss." />
              <outline text="Loneliness: When fleeting and mild, loneliness is more about longing for connection rather than the profound sadness that can accompany prolonged isolation." />
              <outline text="World-Weariness: A temporary feeling of being tired or disillusioned with the state of things. It's more akin to cynicism or jadedness than true sadness." />
              <outline text="Discontentment: A mild dissatisfaction; things aren't quite right but the feeling is fleeting." />
              <outline text="Pensiveness:  A thoughtful, introspective state–perhaps a tinge of melancholy, but not primarily negative." />
              <outline text="Disappointment:  A sense of letdown or unmet expectations; a specific event or situation is the cause." />
              <outline text="Regret:  Wishing something had turned out differently; involves hindsight and a touch of self-recrimination." />
              <outline text="Sadness:  The core emotion–unhappiness, sorrow, low spirits due to loss, setback, or unfulfillment." />
              <outline text="Sorrow:  A deeper and more poignant sadness, often accompanied by a sense of heaviness." />
              <outline text="Despair:  Loss of hope; feeling overwhelmed and unable to see a positive future." />
              <outline text="Anguish:  Intense emotional pain and suffering; a feeling of being torn apart." />
              <outline text="Grief:  The most profound and multifaceted response to loss, encompassing sorrow, yearning, anger, and a restructuring of one's life." />
              <outline text="Complex or Traumatic Grief: While &quot;regular&quot; grief is incredibly challenging, some individuals experience a complicated or prolonged grief reaction. This can involve debilitating symptoms, difficulty moving forward with life, and even PTSD-like symptoms if the loss was traumatic." />
              <outline text="Shock:  In the immediate aftermath of a sudden loss or traumatic event, shock can supersede grief. This state involves emotional numbness, disbelief, and disorientation as the mind struggles to reconcile the reality of what has happened." />
              <outline text="Despair:  While often a component of grief, when despair becomes profound and all-consuming, it can be even more debilitating. Despair involves a complete loss of hope, making the future seem unbearably bleak and making coping feel impossible." />
              <outline text="Complex Emotional Responses to Trauma: Trauma, especially involving violence, abuse, or life-threatening events, can create an incredibly complex spectrum of emotions" />
            </outline>
            <outline text="Anticipation">
              <outline text="Apathy: Lack of feeling or concern towards a given subject matter." />
              <outline text="Neutrality: Neither interested nor opposed; an absence of strong feeling." />
              <outline text="Interest:  A feeling of wanting to learn more about something or become involved in it. It encompasses curiosity and a sense of engagement with the subject matter." />
              <outline text="Curiosity: A desire to learn or know more about something; a spark of engagement." />
              <outline text="Intrigue: Being fascinated with a subject, finding it captivating or puzzling." />
              <outline text="Openness: A willingness to explore a topic or experience further." />
              <outline text="Anticipation:  A feeling of expectation or excitement about something that is going to happen in the future. It involves both a sense of looking forward to something and an element of uncertainty about the outcome. Anticipation can be positive (excited about an event) or negative (anxiety before a test)." />
              <outline text="Excitement: A feeling of positive arousal and eagerness associated with an upcoming event or possibility." />
              <outline text="Enthusiasm: Intense eagerness and enjoyment about something." />
              <outline text="Eagerness: Impatient desire and a strong urge to start or participate in something." />
              <outline text="Restlessness: Physical or mental agitation due to anticipation. Difficulties sitting still or focusing on other tasks." />
              <outline text="Vigilance:  A state of alertness and readiness for potential danger or unexpected developments. It involves focused observation, heightened awareness of surroundings, and the ability to react quickly if needed." />
              <outline text="Hypervigilance: Exaggerated alertness, with intense focus on searching for potential threats (often associated with anxiety or trauma)." />
              <outline text="Suspense: A state of excited yet anxious uncertainty about what's about to happen." />
              <outline text="Foreboding: A sense that something negative or challenging is approaching." />
            </outline>
            <outline text="Joy">
              <outline text="Calmness: A state of peace and tranquility, free from agitation or strong emotions." />
              <outline text="Contentment: A feeling of quiet satisfaction and ease; things are good as they are." />
              <outline text="Serenity: A peaceful state of tranquility and acceptance." />
              <outline text="Happiness: A broader positive emotion, characterized by a sense of well-being, fulfillment, and contentment." />
              <outline text="Amusement: A feeling of being entertained or finding something funny or lighthearted." />
              <outline text="Delight: Pleasure and enjoyment in something that brings a sense of lighthearted satisfaction." />
              <outline text="Joy: An intense feeling of happiness, delight, and well-being." />
              <outline text="Glee: Exuberant delight; a feeling of unrestrained, cheerful joy." />
              <outline text="Elation: Intense happiness and excitement, a burst of positive energy." />
              <outline text="Bliss: A state of complete contentment and profound happiness, often transcending immediate circumstances." />
              <outline text="Rapture: Overwhelming joy and delight, a feeling of being deeply moved or transported." />
              <outline text="Ecstasy: Overwhelming, all-consuming joy, where one might lose a sense of self and feel completely immersed in the moment." />
              <outline text="Euphoria: Intense elation and overwhelming happiness, sometimes with a sense of feeling 'high' or out of body. Can have both positive and negative connotations (drug-induced vs. natural)." />
              <outline text="Transcendence: A profound experience going beyond the ordinary; a feeling of unity with something larger or a deep spiritual connection." />
            </outline>
            <outline text="Surprise">
              <outline text="Focus: Active engagement with a task or thought process." />
              <outline text="Absorption: Being deeply engrossed in an activity, with attention fully captured." />
              <outline text="Distraction: A state where attention is involuntarily diverted away from the present task or focus." />
              <outline text="Curiosity: A mild interest in something unexpected or out of the ordinary, prompting attention to shift." />
              <outline text="Startle: A sudden, involuntary reaction to an unexpected stimulus (loud noise, sudden movement), involves a brief physical jolt." />
              <outline text="Surprise: A sudden, short-lived emotion caused by an unexpected event, leading to heightened attention." />
              <outline text="Astonishment: A feeling of great surprise and confusion, often at something difficult to comprehend immediately." />
              <outline text="Wonder: A sense of awe and fascination with something unusual or extraordinary." />
              <outline text="Disbelief: A state of cognitive dissonance where one struggles to reconcile information with expectations, possibly leading to feelings of shock." />
              <outline text="Amazement: A deep feeling of astonishment and wonder, often prompted by something remarkable or extraordinary." />
              <outline text="Awe: Overwhelming wonder and reverence, often inspired by something vast, powerful, or beautiful. Can involve a feeling of being deeply humbled." />
              <outline text="Shock: A profound feeling of surprise, disturbance, and possible disorientation triggered by a traumatic, unexpected, or deeply unsettling event." />
            </outline>
            <outline text="Trust">
              <outline text="Indifference: No real emotional connection, lack of interest or concern." />
              <outline text="Apprehension: A sense of unease or wariness." />
              <outline text="Acknowledgment: Recognizing someone's existence or presence without further evaluation." />
              <outline text="Curiosity: Mild interest, the desire to learn more." />
              <outline text="Openness: Willingness to consider new information or experiences related to the person." />
              <outline text="Respect: Recognition of someone's worth or value, even if you don't necessarily agree with them." />
              <outline text="Acceptance: Recognizing and tolerating a person's qualities, both positive and negative." />
              <outline text="Rapport: A sense of connection or harmony." />
              <outline text="Liking: Feeling positive or friendly towards the person." />
              <outline text="Trust: Belief in someone's reliability, honesty, and good intentions." />
              <outline text="Confidence: Stronger belief in their abilities and judgment." />
              <outline text="Admiration: Respect along with a sense of positive wonder or esteem." />
              <outline text="Reverence: Deep respect and awe, seeing someone as exceptional." />
              <outline text="Devotion: Deep loyalty and commitment." />
            </outline>
          </outline>
          <outline text="Bronshteyn's Emotional Scale short version">
            <outline text="Trust">
              <outline text="Tolerance: Willingness to endure something disagreeable or allow the existence of different opinions." />
              <outline text="Acceptance: Belief in someone's basic goodness and intentions." />
              <outline text="Reliability: Belief in someone's consistency and dependability; groundwork for trust." />
              <outline text="Trust: Reliance on someone's character and integrity." />
              <outline text="Confidence: Strong belief in someone's abilities and reliability." />
              <outline text="Admiration: Deep respect and positive regard for someone's qualities." />
              <outline text="Reverence: Profound awe, veneration, and respect." />
            </outline>
            <outline text="Anger">
              <outline text="Displeasure: Mild feeling of disapproval or dissatisfaction." />
              <outline text="Annoyance: A more noticeable feeling of being bothered or frustrated." />
              <outline text="Frustration: Impatience and dissatisfaction due to obstacles or unmet expectations." />
              <outline text="Anger: Intense displeasure in response to a provocation or wrong." />
              <outline text="Wrath: Extreme, often vengeful anger." />
              <outline text="Rage: Destructive, uncontrollable anger." />
              <outline text="Hatred: Intense aversion and hostility with the desire to cause harm." />
            </outline>
            <outline text="Anticipation">
              <outline text="Indifference: Lack of interest or emotional investment." />
              <outline text="Interest: Attention or engagement with a subject or event." />
              <outline text="Eagerness: Enthusiastic desire or excited expectation." />
              <outline text="Anticipation: A feeling of excitement about something to come." />
              <outline text="Optimism: Hopefulness and confidence about a future event." />
              <outline text="Vigilance: Watchful alertness and readiness for potential problems or opportunities." />
              <outline text="Hypervigilance: An extreme state of heightened awareness and sensitivity to potential threats or dangers." />
            </outline>
            <outline text="Joy">
              <outline text="Contentment: Peaceful satisfaction and ease." />
              <outline text="Serenity: Calm tranquility and untroubled spirit." />
              <outline text="Cheerfulness: Feeling noticeably happy and optimistic." />
              <outline text="Joy: Intense feeling of happiness and vibrant delight." />
              <outline text="Elation: Feeling of overwhelming happiness and excitement." />
              <outline text="Ecstasy: Overpowering, rapturous joy, loss of self-control." />
              <outline text="Bliss: State of complete happiness, unsurpassed contentment." />
            </outline>
            <outline text="Fear">
              <outline text="Uneasiness: Vague sense of discomfort or restlessness." />
              <outline text="Apprehension: Anxiety or worry about a potential future threat." />
              <outline text="Worry: Anxious preoccupation with negative possibilities or concerns." />
              <outline text="Fear: Strong emotional response to a recognized danger or threat." />
              <outline text="Alarm: Sudden intense fear triggered by imminent perceived danger." />
              <outline text="Terror: Overwhelming fear causing a sense of paralysis or helplessness." />
              <outline text="Dread: Deep, persistent fear of something awful looming in the future." />
            </outline>
            <outline text="Surprise">
              <outline text="Unfocused: Lacking concentration or scattered attention." />
              <outline text="Distraction: Temporary diversion of attention or focus." />
              <outline text="Startlement: A sudden, brief physical shock or reflexive jump." />
              <outline text="Surprise: Feeling caused by something unexpected or out of the ordinary." />
              <outline text="Astonishment: Overwhelming surprise, often with a sense of disbelief." />
              <outline text="Amazement: Great surprise, admiration, and wonder." />
              <outline text="Shock: A sudden, disturbing jolt, can be physical or emotional." />
            </outline>
            <outline text="Sadness">
              <outline text="Disappointment: Feeling of dissatisfaction when expectations aren't met." />
              <outline text="Pensiveness: Thoughtful, mildly melancholic state." />
              <outline text="Regret: Sadness over a past action, missed opportunity, or mistake." />
              <outline text="Sadness: Unhappiness, sorrow, low spirits in response to loss." />
              <outline text="Melancholy: A deeper, more persistent sadness, prone to brooding and reflection." />
              <outline text="Grief: Intense sorrow, especially caused by significant loss through death or separation." />
              <outline text="Despair: Utter hopelessness and dejection, a feeling of everything being lost." />
            </outline>
            <outline text="Disgust">
              <outline text="Apathy: Complete lack of interest, emotion, or motivation." />
              <outline text="Boredom: Feeling weary, unengaged, lacking stimulation." />
              <outline text="Distaste: Mild aversion or disliking without strong rejection." />
              <outline text="Disgust: Strong feeling of revulsion and aversion, a desire to avoid or expel." />
              <outline text="Revulsion: A combination of intense disgust and horror, often accompanied by physical reactions like nausea." />
              <outline text="Loathing: Intense disgust, hatred, and complete rejection." />
              <outline text="Abhorrence: A deep, intense disgust and hatred combined with a desire to cause harm or eliminate the source of the feeling." />
            </outline>
          </outline>
        </outline>

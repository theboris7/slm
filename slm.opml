                <outline text="Helping develop a positive self-image" />
              </outline>
            </outline>
            <outline text="Fostering Healthy Communication">
              <outline text="Open communication">
                <outline text="Creating a safe space to talk about anything" />
              </outline>
              <outline text="Modeling healthy conflict resolution">
                <outline text="Problem-solving without aggression" />
              </outline>
              <outline text="Active listening">
                <outline text="Paying attention and respecting their perspective" />
              </outline>
            </outline>
          </outline>
